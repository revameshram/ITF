{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.assurance-report/v1",
  "title": "AegisVision assurance report",
  "type": "object",
  "required": ["schema", "report_id", "generated_at", "generator", "assessment", "dataset", "model", "findings",
               "evidence", "distribution_shift", "inference_integrity", "audit", "supported_attack_classes",
               "unsupported_attack_classes", "assumptions", "limitations", "recommended_disposition", "integrity"],
  "properties": {
    "schema": {"const": "aegis.assurance-report/v1"},
    "report_id": {"type": "string", "pattern": "^RPT-\\d{4}$"},
    "generated_at": {"type": "string", "description": "ISO-8601 UTC"},
    "generator": {"type": "object", "required": ["name", "version", "mode"]},
    "data_provenance_note": {"type": "string"},
    "case": {
      "type": ["object", "null"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "status": {"type": "string"},
        "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
        "recommended_disposition": {"enum": ["ACCEPT", "REVIEW", "QUARANTINE"]},
        "disposition": {"enum": ["ACCEPT", "REVIEW", "QUARANTINE", null]},
        "chains": {"type": "array"},
        "summary": {"type": "object", "required": ["what_happened", "where", "confidence", "unknowns", "next_steps"]},
        "timeline": {"type": "array"}
      }
    },
    "assessment": {
      "type": "object",
      "required": ["run_id", "started", "finished", "overall", "pillars"],
      "properties": {
        "overall": {"enum": ["TRUSTED", "REVIEW REQUIRED", "UNTRUSTED"]},
        "pillars": {"type": "object", "required": ["dataset", "model", "inference", "distribution", "governance"]}
      }
    },
    "dataset": {"type": "object", "required": ["summary", "manifest", "statistics", "source_table"]},
    "model": {"type": "object", "required": ["deployed"],
              "properties": {"deployed": {"type": "object", "required": ["file", "sha256", "format", "access", "capabilities"]}}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pillar", "category", "title", "what", "why", "severity", "confidence", "confidence_basis",
                     "method", "method_status", "affected", "limitations", "evidence"],
        "properties": {
          "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "method_status": {"enum": ["REAL", "HEURISTIC", "DEMO / SIMULATED"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "finding_id", "kind", "title", "summary", "payload", "sha256"]}
    },
    "correlations": {"type": "array", "items": {"type": "object", "required": ["a", "b", "strength", "rule", "reason"]}},
    "distribution_shift": {"type": "object"},
    "inference_integrity": {"type": "object", "required": ["total", "valid", "invalid", "by_category", "rejected_submissions"]},
    "audit": {"type": "object", "required": ["verification", "history"]},
    "checks_performed": {"type": "array"},
    "supported_attack_classes": {"type": "array", "items": {"type": "string"}},
    "unsupported_attack_classes": {"type": "array", "items": {"type": "string"}},
    "capability_status": {"type": "array"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "recommended_disposition": {"enum": ["ACCEPT", "REVIEW", "QUARANTINE"]},
    "attack_lab_context": {"type": "object"},
    "integrity": {
      "type": "object",
      "required": ["report_sha256", "algorithm", "key_id", "public_key_hex", "signature"],
      "description": "report_sha256 = SHA-256(canonical JSON of the report without 'integrity'); signature = Ed25519(report_sha256)"
    }
  }
}
